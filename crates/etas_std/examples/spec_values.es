import std.random.Rng;
import std.runtime.time.{Duration, Time};

flow main(args: Array<string>) -> i32 ![] {
    let initial = Rng.new(0);
    let (first, a) = initial.next_u64();
    let (second, b) = first.next_u64();
    let (_, c) = second.next_u64();
    std.core.assert(a == 0xe220a8397b1dcdaf);
    std.core.assert(b == 0x6e789e6aa1b965f4);
    std.core.assert(c == 0x06c45d188009454f);
    let (_, repeated) = initial.next_u64();
    std.core.assert(repeated == a);
    let (_, fraction) = first.next_f64();
    std.core.assert(fraction >= 0.0 && fraction < 1.0);
    let (_, sampled) = second.int_range<i128>(-30, 70).unwrap();
    std.core.assert(sampled >= -30 && sampled < 70);
    let input: Array<i32> = [1, 2, 3, 4, 5];
    let (_, shuffled) = initial.shuffle(input);
    std.core.assert(std.collections.sort(shuffled) == input);
    let delay = Duration.from_seconds(2).unwrap().checked_add(Duration.from_millis(250)).unwrap();
    std.core.assert(delay.as_millis() == 2250);
    let before = Time { unix_millis= -1000 };
    let after = before.checked_add(delay).unwrap();
    std.core.assert(after.unix_millis == 1250);
    std.core.assert(after.since(before).unwrap().as_millis() == 2250);
    std.core.assert(std.math.checked_mul<i64>(-37, 12).unwrap() == -444);
    std.core.assert(std.math.div_euclid<i64>(-37, 12).unwrap() == -4);
    std.core.assert(std.math.rem_euclid<i64>(-37, 12).unwrap() == 11);
    std.core.assert(std.math.rotate_left<u8>(0x12, 4) == 0x21);
    std.core.assert(std.math.sqrt<f64>(2.0).bits == 0x3ff6a09e667f3bcd);
    std.core.assert(std.math.sqrt<f32>(9.0) == 3.0);
    std.core.assert(std.math.hypot<f32>(3.0, 4.0) == 5.0);
    let scaled = std.math.hypot<f64>(1e200, 1e200) / 1e200;
    std.core.assert(scaled > 1.4142135623730948 && scaled < 1.4142135623730956);
    std.core.assert(std.math.round<f64>(2.5) == 2.0);
    std.core.assert(std.math.pi<f64>().bits == 0x400921fb54442d18);
    std.core.assert(std.math.exp2<f64>(10.0) == 1024.0);
    std.core.assert(std.math.abs(std.math.exp<f64>(1.0) - std.math.e<f64>()) < 1e-14);
    std.core.assert(std.math.ln<f64>(1.0) == 0.0);
    std.core.assert(std.math.abs(std.math.log2<f64>(8.0) - 3.0) < 1e-14);
    std.core.assert(std.math.abs(std.math.log10<f32>(1000.0) - 3.0) < 0.000001);
    std.core.assert(std.math.pow<f64>(-2.0, 3.0) == -8.0);
    std.core.assert(std.math.pow<f64>(2.0, -3.0) == 0.125);
    std.core.assert(std.math.abs(std.math.atan2<f64>(1.0, 1.0) - std.math.pi<f64>() / 4.0) < 1e-14);
    std.core.assert(std.math.abs(std.math.asin<f64>(0.5) - std.math.pi<f64>() / 6.0) < 1e-14);
    std.core.assert(std.math.abs(std.math.sin<f64>(1.0) - 0.8414709848078965) < 1e-14);
    std.core.assert(std.math.abs(std.math.cos<f64>(1.0) - 0.5403023058681398) < 1e-14);
    std.core.assert(std.math.abs(std.math.tan<f64>(1.0) - 1.5574077246549023) < 1e-14);
    std.core.assert(std.math.abs(std.math.sin<f64>(1e300) - (-0.8178819121159085)) < 1e-14);
    return 0;
}
